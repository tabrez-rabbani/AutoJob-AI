# ──────────────────────────────────────
# AutoJob AI — Environment Variables
# Copy this file to .env and fill in real values
# ──────────────────────────────────────

# App
APP_NAME=AutoJob AI
APP_ENV=production
DEBUG=false

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://autojob:YOUR_DB_PASSWORD@localhost:5432/autojob

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Auth (GENERATE STRONG KEY: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET_KEY=CHANGE_ME_TO_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Encryption (GENERATE KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=CHANGE_ME_TO_FERNET_KEY

# LLM Provider (gemini / openai / groq)
LLM_PROVIDER=groq
LLM_API_KEY=YOUR_LLM_API_KEY_HERE
LLM_MODEL=llama-3.3-70b-versatile

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# CORS (your production frontend URL)
FRONTEND_URL=https://your-domain.com
