# ──────────────────────────────────────
# AutoJob AI — Git Ignore
# ──────────────────────────────────────

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
venv/
.venv/

# Environment files (NEVER commit secrets)
.env
.env.*
!.env.example
backend/.env
frontend/.env.local
frontend/.env.production

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Node
node_modules/
.next/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Sessions (browser cookies — contains login tokens)
sessions/
backend/sessions/

# Uploads (user resumes — contains personal data)
uploads/
backend/uploads/

# Docker
postgres_data/

# Logs
*.log

# Debug files
debug_*.png
debug_*.html
test_out.txt

# Temp/scratch files
*.tmp
*.bak
